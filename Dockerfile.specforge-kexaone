# SpecForge Eagle3 training image for K-EXAONE (exaone_moe architecture)
# Follows Dockerfile.slurm pattern (uv venv + editable install), but on the
# sglang base image with custom forks for exaone_moe support.
FROM lmsysorg/sglang:v0.5.3-cu129

# Copy SpecForge source and set up uv venv (same pattern as Dockerfile.slurm)
COPY SpecForge /opt/specforge
WORKDIR /opt/specforge

RUN rm -rf .venv \
    && python3 -m pip install --no-cache-dir uv \
    && apt-get update \
    && apt-get install -y --no-install-recommends htop nvtop \
    && rm -rf /var/lib/apt/lists/* \
    && uv venv \
    && uv sync --frozen \
    && uv pip install -e .

# Activate venv for all subsequent RUN/CMD
ENV VIRTUAL_ENV=/opt/specforge/.venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

# Install custom SGLang fork with EXAONE MoE + MTP support (overrides stock sglang from lockfile)
RUN rm -rf /opt/sglang && \
    git clone --branch exaone_moe_official --depth 1 \
    https://github.com/xvyaward/sglang.git /opt/sglang
WORKDIR /opt/sglang
RUN uv pip install -e "python[all]"

# Install custom transformers for exaone_moe config class
RUN uv pip install --reinstall git+https://github.com/Aim-Highest/transformers.git

# Reinstall flash-attn to fix version 'N/A' issue
RUN uv pip install flash-attn --no-build-isolation

WORKDIR /workspace
CMD ["bash"]
